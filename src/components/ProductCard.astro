---
import type { Product } from "../data/products";

interface Props {
	product: Product;
}

const { product } = Astro.props;
---

<div
	class="group flex flex-col justify-between bg-[#16141a]/80 backdrop-blur-sm border border-[#4D465D]/70 hover:border-green-500 rounded-2xl p-5 transition-all ease-in-out duration-150 hover:-translate-y-1 shadow-lg"
>
	<div>
		<div class="flex items-center justify-between gap-2 mb-2">
			<h3 class="text-white text-lg font-bold font-['Poppins']">
				{product.title}
			</h3>
			<span
				class="text-green-400 font-bold text-sm px-2.5 py-0.5 rounded-full bg-green-500/10 border border-green-500/20"
			>
				{product.price}
			</span>
		</div>
		{
			product.badge && (
				<span class="inline-block mb-3 px-2 py-0.5 rounded text-xs font-semibold bg-[#4D465D]/40 text-[#E4DCF4]/90 border border-[#4D465D]/50">
					{product.badge}
				</span>
			)
		}
		<p class="text-[#E4DCF4]/75 text-sm font-['Poppins'] mb-4 leading-relaxed">
			{product.description}
		</p>
		{
			product.perks && product.perks.length > 0 && (
				<ul class="space-y-2.5 mb-6 pt-3 border-t border-[#4D465D]/40 text-xs text-[#E4DCF4]/90 font-['Poppins']">
					{product.perks.map((perk) => (
						<li class="flex items-center gap-2">
							<svg
								class="w-4 h-4 text-green-400 shrink-0"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
								stroke-width="2.5"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M5 13l4 4L19 7"
								/>
							</svg>
							<span>{perk}</span>
						</li>
					))}
				</ul>
			)
		}
	</div>
	<a
		href={product.actionUrl}
		target="_blank"
		rel="noopener noreferrer"
		class="w-full text-center py-2.5 px-4 rounded-xl bg-green-500 hover:bg-green-400 text-black font-semibold font-['Poppins'] transition-all ease-in-out duration-150 shadow-md hover:shadow-green-500/20"
	>
		{product.actionText}
	</a>
</div>
